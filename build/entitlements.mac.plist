<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the signed macOS build, referenced from
  electron-builder.yml (`mac.entitlements` / `mac.entitlementsInherit`).

  Electron's V8 needs JIT and writable-executable memory, and
  @lydell/node-pty loads a native binding that is not signed with Vertragus'
  own certificate — without disable-library-validation the hardened runtime
  would refuse to load it and every agent spawn would die at launch.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
